# Android emulator -> host machine. USB alternatives: docs/LOCAL_DEVELOPMENT.md.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# api | demo. Demo is explicit and never silently replaces API failures.
EXPO_PUBLIC_DATA_MODE=api
# Development-only tester token. Every EXPO_PUBLIC_* value is public in the app.
EXPO_PUBLIC_DEV_TESTER_TOKEN=GENERATED_BY_BOOTSTRAP
# Set an HTTPS domain that you control before enabling wallet connection.
EXPO_PUBLIC_WALLET_IDENTITY_URI=
